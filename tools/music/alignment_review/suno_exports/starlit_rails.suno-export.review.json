  "lines": [
    {
      "line": 1,
      "text": "검문소 불빛이",
      "start": 18.67,
      "end": 22.978
    },
    {
      "line": 2,
      "text": "어둠을 가르고",
      "start": 22.978,
      "end": 29.44
    },
    {
      "line": 3,
      "text": "네 대의 그림자",
      "start": 29.44,
      "end": 35.904
    },
    {
      "line": 4,
      "text": "우리를 둘러쌌지",
      "start": 35.904,
      "end": 39.573
    },
    {
      "line": 5,
      "text": "숨을 죽이고",
      "start": 39.573,
      "end": 44.92
    },
    {
      "line": 6,
      "text": "손을 떨며",
      "start": 44.92,
      "end": 48.511
    },
    {
      "line": 7,
      "text": "얼굴엔 아무것도",
      "start": 48.511,
      "end": 50.904
    },
    {
      "line": 8,
      "text": "드러내지 않았어",
      "start": 50.904,
      "end": 53.905
    },
    {
      "line": 9,
      "text": "심박수 백사십칠",
      "start": 54.255,
      "end": 60.558
    },
    {
      "line": 10,
      "text": "듣고 있어요",
      "start": 60.558,
      "end": 63.43
    },
    {
      "line": 11,
      "text": "무서워도",
      "start": 63.43,
      "end": 67.978
    },
    {
      "line": 12,
      "text": "멈추지 않았죠",
      "start": 67.978,
      "end": 69.064
    },
    {
      "line": 13,
      "text": "밤이 깊어도",
      "start": 69.41499999999999,
      "end": 74.281
    },
    {
      "line": 14,
      "text": "다시 밝아와",
      "start": 74.281,
      "end": 77.47200000000001
    },
    {
      "line": 15,
      "text": "저 철길처럼",
      "start": 77.47200000000001,
      "end": 79.706
    },
    {
      "line": 16,
      "text": "끝까지 가는 거야",
      "start": 79.706,
      "end": 83.777
    },
    {
      "line": 17,
      "text": "길이 험해도",
      "start": 83.777,
      "end": 86.968
    },
    {
      "line": 18,
      "text": "우린 함께야",
      "start": 86.968,
      "end": 91.037
    },
    {
      "line": 19,
      "text": "이 하늘 아래",
      "start": 91.037,
      "end": 92.632
    },
    {
      "line": 20,
      "text": "혼자가 아니야",
      "start": 92.632,
