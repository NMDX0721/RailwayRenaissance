#dialogue-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background-color: rgba(30, 20, 15, 0.85);
    border-width: 2px;
    border-color: rgba(200, 150, 80, 0.6);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 20px;
    flex-direction: column;
}

#name-area {
    height: 30px;
    margin-bottom: 8px;
}

#speaker-name {
    font-size: 22px;
    color: rgba(255, 200, 100, 1.0);
    -unity-font-style: bold;
}

#divider {
    height: 1px;
    background-color: rgba(200, 150, 80, 0.3);
    margin-bottom: 12px;
}

#text-area {
    flex-grow: 1;
    overflow: hidden;
}

#dialogue-text {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.95);
    white-space: normal;
    overflow: hidden;
}

#continue-indicator {
    position: absolute;
    bottom: 20px;
    right: 20px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.5);
    display: none;
}