--- !u!114 &1845703198
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1845703196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2966b6a37a589284483b1833a1e63a0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RailwayRenaissance.Cab.CabWorkstationEquipment
  kind: 0
  volumeKnob: {fileID: 1043437228}
  channelKnob: {fileID: 2112201463}
  powerLamp: {fileID: 1611225022}
  lampOff: {fileID: 2100000, guid: dd50262b14acd514d96ab6b64418cd55, type: 2}
  lampOn: {fileID: 2100000, guid: 1a43d7a038ba36c44a2fe03b3ff14df9, type: 2}
  document: "\u677E\u5CAD\u901A\u4FE1 \xB7 SL-R8 \u5217\u8F66\u65E0\u7EBF\u7535\nSONGLING
    COMMUNICATIONS \xB7 SL-R8 TRAIN RADIO\n\n\u5F00\u5173 / POWER\uFF1A\u63A5\u901A\u6216\u5173\u95ED\u672C\u673A\u3002\n\u9891\u9053
    / CHANNEL\uFF1A\u516B\u6863\u9884\u7F6E\u9891\u9053\uFF0C\u6309\u8C03\u5EA6\u547D\u4EE4\u9009\u5B9A\u3002\n\u97F3\u91CF
    / VOLUME\uFF1A\u516D\u6863\u63A5\u6536\u97F3\u91CF\uFF0C0 \u4E3A\u9759\u97F3\u3002\n\n\u51FA\u4E58\u68C0\u67E5\uFF1A\u6838\u5BF9\u9891\u9053\u3001\u68C0\u67E5\u542C\u7B52\u5F52\u4F4D\u53CA\u5F15\u7EBF\u56FA\u5B9A\u3002\u901A\u8BDD\u524D\u786E\u8BA4\u5BF9\u65B9\u8EAB\u4EFD\uFF0C\u4F7F\u7528\u5217\u8F66\u547C\u53F7\uFF1B\u547D\u4EE4\u987B\u590D\u8BF5\u5E76\u786E\u8BA4\u3002\nPRE-DEPARTURE:
    Verify the assigned channel, secure the handset and inspect its lead. Identify
    both parties, use the train call sign, repeat instructions and obtain confirmation.\n\n\u4F9B\u7535\u4E2D\u65AD\u65F6\uFF0C\u65CB\u94AE\u4F4D\u7F6E\u4ECD\u4FDD\u7559\uFF1B\u6062\u590D\u4F9B\u7535\u540E\u6838\u5BF9\u9891\u9053\u3002\nAfter
    a power interruption, check the retained channel setting.\n\n\u7EF4\u62A4\uFF1A\u65AD\u7535\u540E\u68C0\u67E5\u56FA\u5B9A\u811A\u548C\u63A5\u63D2\u4EF6\u3002\u52FF\u62C9\u626F\u542C\u7B52\u5F15\u7EBF\u3002\nMAINTENANCE:
    Isolate power before checking mounts and connectors. Do not pull the handset
    cable."
  volumeRest: {x: 0.70710677, y: -0, z: -0, w: 0.70710677}
  channelRest: {x: 0.70710677, y: -0, z: -0, w: 0.70710677}
  initialized: 1
