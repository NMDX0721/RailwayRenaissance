--- !u!114 &2131212713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2131212711}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2966b6a37a589284483b1833a1e63a0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RailwayRenaissance.Cab.CabWorkstationEquipment
  kind: 1
  volumeKnob: {fileID: 0}
  channelKnob: {fileID: 0}
  powerLamp: {fileID: 0}
  lampOff: {fileID: 0}
  lampOn: {fileID: 0}
  document: "NF-5K \xB7 \u968F\u8F66\u68C0\u67E5\u8BB0\u5F55\nONBOARD CHECK RECORD
    \xB7 FORM CW-01\n\n\u4E00\u3001\u51FA\u4E58\u524D / BEFORE DEPARTURE\n\u25A1
    \u5236\u52A8\u4E0E\u98CE\u538B\uFF1A\u6309\u89C4\u5B9A\u5B8C\u6210\u8BD5\u9A8C\uFF0C\u6838\u5BF9\u538B\u529B\u5EFA\u7ACB\u4E0E\u4FDD\u6301\u3002\n 
    BRAKES & AIR: Complete the prescribed brake test; verify pressure build-up and
    retention.\n\u25A1 \u901A\u4FE1\uFF1A\u6838\u5BF9\u8C03\u5EA6\u6307\u5B9A\u9891\u9053\uFF0C\u68C0\u67E5\u542C\u7B52\u4E0E\u5F15\u7EBF\u3002\n 
    COMMUNICATIONS: Verify the assigned channel, handset and cable.\n\u25A1 \u8F66\u95E8\u4E0E\u901A\u9053\uFF1A\u68C0\u67E5\u5173\u95ED\u72B6\u6001\u53CA\u4EBA\u5458\u901A\u884C\u7A7A\u95F4\u3002\n 
    DOORS & AISLES: Check door security and keep access clear.\n\u25A1 \u5B89\u5168\u5668\u6750\uFF1A\u68C0\u67E5\u56FA\u5B9A\u3001\u5C01\u8BC6\u4E0E\u68C0\u67E5\u8BB0\u5F55\u3002\n 
    SAFETY EQUIPMENT: Check restraints, seals and inspection records.\n\n\u4E8C\u3001\u9014\u4E2D\u8BB0\u5F55
    / EN-ROUTE NOTES\n\u65F6\u95F4 TIME ______  \u533A\u95F4 SECTION ______\n\u73B0\u8C61
    OBSERVATION __________________\n\u5904\u7F6E ACTION _______________________\n\n\u4E09\u3001\u4EA4\u63A5
    / HANDOVER\n\u672A\u7ED3\u4E8B\u9879 OUTSTANDING ITEMS __________\n\u4EA4\u73ED
    CREW OUT ______  \u63A5\u73ED CREW IN ______\n\n\u7559\u5B58\u4E8E\u968F\u8F66\u8D44\u6599\u5939\u3002
    / KEEP IN THE ONBOARD DOCUMENT CLIPBOARD."
  volumeRest: {x: 0, y: 0, z: 0, w: 0}
  channelRest: {x: 0, y: 0, z: 0, w: 0}
  initialized: 1
