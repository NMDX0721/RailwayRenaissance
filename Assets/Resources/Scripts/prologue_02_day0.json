      "d": [
        {
          "t": "n",
          "text": "Day 0 下午"
        },
        {
          "t": "loc",
          "text": "平壤铁道综合大学 · 试验停机坪"
        },
        {
          "t": "n",
          "text": "尖锐的高频电磁啸叫声骤然撕裂死寂。"
        },
        {
          "t": "n",
          "text": "我浑身一震，下意识捂住双耳向后退开。"
        },
        {
          "t": "n",
          "text": "后颈渗出的冷汗被过堂风吹得发凉。"
        },
        {
          "t": "n",
          "text": "还以为是高压稳压电容发生了致命短路。"
        },
        {
          "t": "n",
          "text": "导师却站在一旁，从容抬手示意我安心。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "二十三年没通电，电容第一次充饱，骨头节子总得响两声。",
          "e": "gentle"
        },
        {
          "t": "n",
          "text": "昏暗空旷的重型机库中央卧着一尊怪兽。"
        },
        {
          "t": "n",
          "text": "粗壮厚重的深蓝色合金艇身满是岁月斑驳。"
        },
        {
          "t": "n",
          "text": "两侧进气导流栅格结满发黄的粗盐碱霜。"
        },
        {
          "t": "n",
          "text": "机身侧翼用粗糙白漆喷涂着编号：0721。"
        },
        {
          "t": "n",
          "text": "编号正下方铆接这一块暗红铸铁铭牌。"
        },
        {
          "t": "n",
          "text": "上面赫然铸着雾峰村特有的交叉双轨徽记。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "刚才那声刺耳尖啸……真不是线路击穿打火？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "放一百个心。这是电枢核心重新建压的自检蜂鸣。",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "整整二十三年没动过了。今天为了你，特意重新通的电。",
          "e": "normal"
        },
        {
          "t": "n",
          "text": "此时车旁站着一位戴着工作牌的中年男人。"
        },
        {
          "t": "n",
          "text": "他是大学车队管理员，负责封存这批试验车。"
        },
        {
          "t": "n",
          "text": "见导师领我走过来，他默默点头退到了一旁。"
        },
        {
          "t": "n",
          "text": "我绕着庞大粗犷的重型机体慢慢踱步。"
        },
        {
          "t": "n",
          "text": "双排气歧管紧紧裹着防热石棉隔层。"
        },
        {
          "t": "n",
          "text": "厚重风挡四周全是一丝不苟的手工焊纹。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "这台车的钣金工艺……看着根本不像流水线上的民用货。",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "算你识货。这是当年全境唯一一辆战备两栖原型车。",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "当年为了应对地质剧变，部里下了死命令秘密研制的独苗。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "它的底盘既能吸附在传统铁轨上高速滑行，又能喷气腾空越障。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "既能在轨道上跑，又能离地浮空飞行？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "可惜啊，试验刚跑完，大拆除的风暴就席卷了全境。",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "全世界都在抢沙子搞浮空，没人愿意再在铁轨上花哪怕一分钱。",
          "e": "normal"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "投资方撤资，全套配套工厂转产，这台车就被直接封死在这里。",
          "e": "sad"
        },
        {
          "t": "n",
          "text": "我走到机尾检修盖旁，轻轻抹去灰尘。"
        },
        {
          "t": "n",
          "text": "钢板边缘赫然烙着一行极其清晰的钢印："
        },
        {
          "t": "n",
          "text": "『林悍 2053.4.12 验收合格』。"
        },
        {
          "t": "n",
          "text": "那笔锋正是我爷爷生前极其罕见的工签名！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "这是……爷爷当年的亲笔验收签字？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "这台车的底盘调校，你爷爷当年亲自趴在底下改了整整三个月。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "那老汉一辈子骨头硬，做完的事从不显摆。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "部里把这车打入冷宫封存那天，他也是这样一个人在机库坐了一整夜。",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "临走前，他亲手把自己的工号钢印砸在了机尾这块盖板上。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "所以它被孤零零锁在这里，等了整整二十三年。",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "是啊。但今天，老林家的后人终于来领它回家了。",
          "e": "smile"
        },
        {
          "t": "n",
          "text": "我的手指轻轻按在微凉的铸铁外壳上。"
        },
        {
          "t": "n",
          "text": "冰冷钢铁深处，传来极其轻微的低频震颤。"
        },
        {
          "t": "n",
          "text": "像一头终于被唤醒心跳的沉睡巨兽。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "走近点吧。感应门禁系统已经录入并锁定了你的生物特征。",
          "e": "gentle"
        },
        {
          "t": "n",
          "text": "伴随着液压气浪声，客舱侧门缓缓滑开。"
        }
      ]
    },
    {
      "bg": "cabin_interior",
      "bgm": "cloud_rail",
      "transition": "fade",
      "chars": [
        {
          "name": "daoshi",
          "pos": "right"
        },
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ],
      "d": [
        {
          "t": "n",
          "text": "我踩上防滑踏板，弯腰跨进这间座舱。"
        },
        {
          "t": "n",
          "text": "陈年防锈油与松香的微涩气味扑面而来。"
        },
        {
          "t": "n",
          "text": "身后的厚重装甲舱门嗤的一声自动闭锁。"
        },
        {
          "t": "n",
          "text": "两张带双向减震气囊的帆布座椅相对而立。"
        },
        {
          "t": "n",
          "text": "中间架着一张可折叠收纳的胡桃木方桌。"
        },
        {
          "t": "n",
          "text": "前方的驾驶台上，机械仪表与数码管错落交织。"
        },
        {
          "t": "n",
          "text": "仪表台最上方嵌着两位已故领袖的黄铜相框。"
        },
        {
          "t": "n",
          "text": "铜框边缘被擦得锃亮，在暗光下泛着幽光。"
        },
        {
          "t": "n",
          "text": "一切都完好保持着二十三年前的模样。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "拉开仪表台右下侧的电木盖，把那个红色主断路器推上去。",
          "e": "normal"
        },
        {
          "t": "n",
          "text": "我握住冰凉沉重的胶木手柄，用力推死。"
        },
        {
          "t": "n",
          "text": "轰的一声沉闷轰鸣在地板深处骤然爆发。"
        },
        {
          "t": "n",
          "text": "橘黄色的数码管如灯带般一排排亮起。"
        },
        {
          "t": "n",
          "text": "中央阴极射线显示屏泛起翠绿的水波纹。"
        },
        {
          "t": "n",
          "text": "紧接着，一道清脆灵动的少女声线响彻座舱："
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "——神经元逻辑回路握手成功！全传感器自检通过，系统重启完成！",
          "e": "excited"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "哇啊！这、这是谁在说话？！",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "初次见面！我是第一代战备铁路自主推演AI，代号……『岁月』！",
          "e": "smile"
        },
        {
          "t": "n",
          "text": "屏幕上跳出一个活灵活现的像素少女笑脸。"
        },
        {
          "t": "n",
          "text": "两只由翠绿光点构成的眼睛冲我灵巧眨眼。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "二十三年前的老古董……居然装载了全逻辑自适应强人工智能？",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "她是当年全境最高保密级别项目的核心结晶，全国只造出这一个。",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "不同于现在的那些傻瓜导航机，她能自主理解地形与轨道拓扑。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "识别到目标生物特征：林彪悍，平壤铁道综合大学自动化系学生！",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "您果然就是林悍总工程师的亲孙子！我一直处于待机状态等您唤醒呢！",
          "e": "excited"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "你……真的认得我爷爷？",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当然认得！我的底层引导固件第一行根证书，就是林总工亲笔签发烧录的！",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当时林总工太激动，还把半杯热咖啡洒在控制台边，第三主板区至今留着焦糖痕迹呢！",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "连泼咖啡的糗事都能记着……看来你这电子脑子比人脑还灵。",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "哼哼，我的磁畴晶格存储器可是永不褪色、永久纠错的！",
          "e": "smug"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "不过……检测到外置高压储能电容仅剩两成基础存量，远航前必须充饱！",
          "e": "worried"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "地勤电缆正在浮充，等我们办完手续，电量肯定能拉满。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "放心，二十三年都等过来了，不差充饱电这半天。",
          "e": "smile"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "收到！已启动低功耗吸储协议，向大电网大口吞咽能量中！",
          "e": "happy"
        },
        {
          "t": "n",
          "text": "我注视着屏幕上那道活泼跳动的绿色脉冲。"
        },
        {
          "t": "n",
          "text": "心头原有的陌生与戒备，悄然消散了大半。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "先别光顾着叙旧。跟我回趟办公室，关键交代还没给你交底。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "好的！岁月转入后台静默待命，随时恭候您的起飞指令！",
          "e": "smile"
        },
        {
          "t": "n",
          "text": "我点点头，轻拍了一下仪表台，跨出客舱。"
        }
      ]
    },
    {
      "bg": "professor_office",
      "bgm": "calm",
      "transition": "fade",
      "chars": [
        {
          "name": "daoshi",
          "pos": "right"
        },
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ],
      "d": [
        {
          "t": "n",
          "text": "穿过长廊，我跟着导师回到熟悉的办公室。"
        },
        {
          "t": "n",
          "text": "宽大的红木桌上杂乱堆着泛黄的全国铁路图。"
        },
        {
          "t": "n",
          "text": "导师倒了一杯刚煮开的炒青粗茶推给我。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "你决定回雾峰村接手那条烂摊子，我知道凭我是拦不住你了。",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "但既然要走，有三件关乎性命的事你必须死死烂在肚子里。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "老师您说，我每一条都会记牢。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "第一件：0721号在大学账面上属于报废科研教具，我以野外考察名义批给你。",
          "e": "normal"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "我给你开了带大红公章的特别通行证与工民建勘探证明。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "路上遇到地方巡防队或矿警刁难盘查，掏出这封公函，他们不敢随意扣车。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "明白了，这是能挡住官僚盘剥的合法护身符。",
          "e": "normal"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "第二件：为什么退役车里，我偏偏力排众议把0721号留给你？",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "如今满天乱飞的民用沙能飞艇，全都极度依赖近地商业轨道卫星导引。",
          "e": "normal"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "一旦飞进东北部的重度地磁异常区，所有商业导航信号全都会彻底归零。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "但岁月不同。她的储存库里，封存着大拆除之前全境所有铁路拓扑档案。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "每一个道班、高架桥、隧道的经纬度与地磁偏角，全在她脑子里。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "在群山迷失航向时，不要相信卫星，去相信岁月，她认得每一寸钢轨。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "难怪刚才开机时，她能一口报出沿途所有地质断裂带的数据。",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "因为她生来就是为了在大地上奔跑、寻找铁道而建造的。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "至于第三件……也是眼前最棘手、最现实的事。",
          "e": "normal"
        },
        {
          "t": "n",
          "text": "导师从上锁的抽屉摸出一张烫金纸质请柬。"
        },
        {
          "t": "n",
          "text": "上面写着一个典雅地址：大同江茶馆。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "出发南下之前，去见一个人。她能解你的燃眉之急。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "大同江茶馆？我听说那是商界巨擘出入的高级会所。",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "有位徐小姐在那里等你。她名下掌管着东北亚铁路复兴专项基金。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "她在市里专班说话极有分量，更重要的是，她当年欠你爷爷一份人情。",
          "e": "serious"
        },
        {
