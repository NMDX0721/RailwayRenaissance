{
  "id": "prologue_07_first_repair",
  "scenes": [
    {
      "bg": "depot_morning",
      "bgm": "morning",
      "transition": "fade",
      "d": [
        {"t": "n", "text": "【Day 5 早晨】"},
        {"t": "n", "text": "【机库内，NF-5耕牛静静停着】"},
        {"t": "n", "text": "【机车表面布满灰尘，部分零件已经拆卸】"},
        {"t": "d", "s": "老陈", "text": "这就是「耕牛」。你爷爷最骄傲的伙伴。NF-5型，2000千瓦柴油机，当年可是主力机型。"},
        {"t": "d", "s": "老陈", "text": "现在...你看看。喷油嘴堵了，柴油机供油不畅。没有专业工具，我拆不下来。"}
      ]
    },
    {
      "bg": "depot_morning",
      "bgm": "morning",
      "d": [
        {"t": "d", "s": "张工", "text": "要不我试试？虽然我退休这几年手生了，但当年修过的车比吃过的饭还多。", "e": "smile"},
        {"t": "c", "text": "谁来负责维修？", "opts": [
          {"text": "让张工上（保险，花500沙币买零件）", "next": 2, "setValue": "repair_choice=zhang"},
          {"text": "自己动手（省钱，但风险高）", "next": 3, "setValue": "repair_choice=self"},
          {"text": "先检查再决定（谨慎）", "next": 4, "setValue": "repair_choice=check"}
        ]}
      ]
    },
    {
      "bg": "depot_morning",
      "bgm": "determination",
      "d": [
        {"t": "n", "text": "【张工熟练地拆下喷油嘴，仔细检查】"},
        {"t": "d", "s": "张工", "text": "喷嘴积碳严重，需要换新的。我去镇上找找配件。"},
        {"t": "d", "s": "老陈", "text": "好，这是500块。买配件剩下的买点润滑油。"},
        {"t": "d", "s": "林彪悍", "text": "辛苦了，张工。", "e": "smile"},
        {"t": "n", "text": "【张工出去了，剩下的人开始清理机库】"},
        {"t": "n", "text": "【资金 -500沙币 → 剧情推进】"},
        {"t": "d", "s": "岁月", "text": "维修任务已记录。预计今天下午可以完成。"},
        {"t": "n", "text": "【维修任务完成，机车状态恢复至75/100】"}
      ]
    },
    {
      "bg": "depot_morning",
      "bgm": "determination",
      "d": [
        {"t": "n", "text": "【你挽起袖子，准备自己动手】"},
        {"t": "d", "s": "林彪悍", "text": "我在学校学过柴油机原理。燃油喷射系统是核心课程之一。"},
        {"t": "d", "s": "老陈", "text": "你确定？这可不是实验室。"},
        {"t": "d", "s": "林彪悍", "text": "我确定。", "e": "serious"},
        {"t": "n", "text": "【两个小时后...】"},
        {"t": "d", "s": "张工", "text": "好小子！还真让你修好了！", "e": "smile"},
        {"t": "n", "text": "【机车状态恢复至70/100，但花费了3小时】"},
        {"t": "n", "text": "【省钱但费时，下午的首班车将推迟到傍晚】"}
      ]
    },
    {
      "bg": "depot_morning",
      "bgm": "calm",
      "d": [
        {"t": "n", "text": "【你仔细检查了喷油嘴的各项参数】"},
        {"t": "d", "s": "林彪悍", "text": "积碳不严重，先清洗试试。实在不行再换。"},
        {"t": "d", "s": "张工", "text": "好主意，省点是点。"},
        {"t": "n", "text": "【清洗后测试，喷油嘴工作正常】"},
        {"t": "d", "s": "老陈", "text": "好！看来今天就能试车了！", "e": "smile"},
        {"t": "n", "text": "【机车状态恢复至72/100，省钱省时】"},
        {"t": "d", "s": "林彪悍", "text": "陈爷爷，准备发车吧。", "e": "smile"}
      ]
    }
  ]
}