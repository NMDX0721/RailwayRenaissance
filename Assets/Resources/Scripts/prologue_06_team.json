{
  "id": "prologue_06_team",
  "scenes": [
    {
      "bg": "station_night",
      "bgm": "platform",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "Day 5 晚上"
        },
        {
          "t": "loc",
          "text": "雾峰村车站 · 站台 · 0km"
        },
        {
          "t": "cg",
          "text": "cg_team_night",
          "size": "full"
        },
        {
          "t": "n",
          "text": "秋夜的山风像冰水倒灌。"
        },
        {
          "t": "n",
          "text": "站台上的光管滋滋闪烁。"
        },
        {
          "t": "n",
          "text": "光影在水泥地上跳动。"
        },
        {
          "t": "n",
          "text": "五个人散在惨白的光圈边缘。"
        },
        {
          "t": "n",
          "text": "身上全穿着洗褪色的旧工装。"
        },
        {
          "t": "n",
          "text": "衣角被夜风吹得猎猎作响。"
        },
        {
          "t": "n",
          "text": "彼此隔着生疏防备的空隙。"
        },
        {
          "t": "n",
          "text": "谁也没有主动迎上来。"
        },
        {
          "t": "d",
          "s": "老陈",
          "e": "normal",
          "text": "各位，人都到齐了。这是林彪悍，林站长的亲孙子，从平壤回来的。愿意接手……"
        },
        {
          "t": "n",
          "text": "李阿姨直接往前迈出半步。"
        },
        {
          "t": "n",
          "text": "她怀里紧抱着一只铁皮算盘。"
        },
        {
          "t": "n",
          "text": "算盘底下压着发黄的硬皮账。"
        },
        {
          "t": "n",
          "text": "硬生生把老陈的话截在半空。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "老陈，人回来了是天大的喜事。可有些账，当着林站长孙子的面，今晚就得摊在桌面上。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "站里账上就剩两千零四十沙币。下河村三十袋粗柴油的代购钱，还拖欠着人家的粮票。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "供电所昨天就下了通告，下周再不结清电费，调度室和车棚的灯全得拉闸断电。"
        },
        {
          "t": "n",
          "text": "她从兜里掏出一把压票机。"
        },
        {
          "t": "n",
          "text": "铸铁机身生了一层暗红的锈。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "抽屉里还锁着两箱硬板客票。四年前停运那天的钢印日期，到现在还卡在字轮上转不动。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "大学生，你从平壤名牌大学回来，上头批了多少专项扶持款？能给大伙补几个月的工钱？"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "serious",
          "text": "要是兜里空空如也，这条烂了四年的线，二十三公里的断轨，你打算拿什么填？"
        },
        {
          "t": "n",
          "text": "站台上一片死寂。"
        },
        {
          "t": "n",
          "text": "只有山风刮过锈轨的呼啸。"
        },
        {
          "t": "d",
          "s": "老陈",
          "e": "worried",
          "text": "秀兰，孩子傍晚才刚走完十五公里巡线，脚底全是血泡，你容他喘口气……"
        },
        {
          "t": "n",
          "text": "水泥柱后传来一声冷笑。"
        },
        {
          "t": "n",
          "text": "张工从阴影里慢慢踱步出来。"
        },
        {
          "t": "n",
          "text": "他手里握着一支旧游标卡尺。"
        },
        {
          "t": "n",
          "text": "主尺刻度早被机油老茧磨平。"
        },
        {
          "t": "n",
          "text": "藏青夹克上泛着焦油的气味。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "下午你在车棚里跟喷油泵较劲的事，老陈跟我说过了。一身蛮力，方向却反拧了半扣。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "螺栓没拔出来，泵体座孔的内螺纹差点被你绞死。大学生，图纸跟趴在棚里的老耕牛，两码事。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "喷油嘴喷孔孔径零点二五毫米，雾化角偏移半度，整台柴油机就得在坡道上熄火烧缸。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "调速器的飞锤间隙你看过没有？供油拉杆卡死在零供油位，你硬踩油门除了烧电机什么用都没有。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "我修了二十八年机车，特级技师证书还在铁盒里压着。连活扳手开口都调不准的人，拿什么领我们大修？"
        },
        {
          "t": "n",
          "text": "道砟边蹲着一个干瘪瘦老头。"
        },
        {
          "t": "n",
          "text": "那是赵师傅，提着长柄道钉锤。"
        },
        {
          "t": "n",
          "text": "锤头已经敲得四角凹陷泛光。"
        },
        {
          "t": "n",
          "text": "脚边放着装满断钉的破铁桶。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "serious",
          "text": "铁轨早就不认人了。两边荒草长得比人高，枕木烂成了黑泥，道钉全锈成了死疙瘩。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "calm",
          "text": "老站长在的时候，我一天巡两趟，哪根轨缝大了一毫米，脚底板踩上去就能觉出来。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "serious",
          "text": "七月份钢轨暴晒爬行，十一月份冻害路基起拱，全靠人在冰天雪地里拿肩膀扛着起道机去顶。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "serious",
          "text": "出站那段千分之十二的大坡道，两百五十米曲线半径，钢轨侧磨早超过了八毫米限度。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "calm",
          "text": "老站长一走，这条线就咽气了。我这把老骨头黄土埋到脖子，犯不着陪一个没走过夜路的后生瞎折腾。"
        },
        {
          "t": "n",
          "text": "王小弟站在最后头，浑身紧绷。"
        },
        {
          "t": "n",
          "text": "大檐帽被他死死攥在手心里。"
        },
        {
          "t": "n",
          "text": "指节泛白，脸上红一阵白一阵。"
        },
        {
          "t": "d",
          "s": "王小弟",
          "e": "worried",
          "text": "站长……我、我去年刚分来，铁路就全线停了。村里开沙能轻卡的同龄人，天天笑话我是给死人看大门的。"
        },
        {
          "t": "d",
          "s": "王小弟",
          "e": "curious",
          "text": "可我不甘心！四年里我一个人在车库练习接风管、换风闸制动片，手皮磨破了又长出老茧。"
        },
        {
          "t": "d",
          "s": "王小弟",
          "e": "excited",
          "text": "车底下的基础制动连杆我都摸熟了！只要这车真能再喷出一口黑烟，我扛钢轨、推道砟板车，哪怕累脱一层皮我都认！"
        },
        {
          "t": "n",
          "text": "调度室的木门吱呀一声推开。"
        },
        {
          "t": "n",
          "text": "小芳抱着两卷褪色手旗走出来。"
        },
        {
          "t": "n",
          "text": "黄铜旗杆头被她擦得锃亮。"
        },
        {
          "t": "d",
          "s": "小芳",
          "e": "sad",
          "text": "调度台那部手摇磁石电话，四年里除了镇供电所催缴电费，没响过一次行车闭塞铃声。"
        },
        {
          "t": "d",
          "s": "小芳",
          "e": "sad",
          "text": "但我每天早中晚换班，都用棉布擦它三遍。老站长以前教过我，只要铁轨还在，行车闭塞的规矩就不能废。"
        },
        {
          "t": "d",
          "s": "小芳",
          "e": "sad",
          "text": "机房里那台电气路签机，二十四颗黄铜路签球我还锁在铸铁匣子里，每周上一回润滑油。"
        },
        {
          "t": "d",
          "s": "小芳",
          "e": "serious",
          "text": "可四年了……我们天天守着不响的电话，擦着不动的信号机，到底是在等车来，还是在给车站守灵？"
        },
        {
          "t": "n",
          "text": "五对眼睛沉甸甸地压在我身上。"
        },
        {
          "t": "n",
          "text": "目光里没有尖刻的敌意。"
        },
        {
          "t": "n",
          "text": "全是四年荒废磨出的深沉刺痛。"
        },
        {
          "t": "thought",
          "s": "林彪悍",
          "e": "serious",
          "text": "[他们不是在赶我走。他们是怕再一次被希望骗得粉身碎骨。]"
        }
      ]
    },
    {
      "bg": "station_night",
      "bgm": "platform",
      "d": [
        {
          "t": "n",
          "text": "我深吸一口带铁锈腥味的冷气。"
        },
        {
          "t": "n",
          "text": "右手按在冰凉粗糙的水泥栏上。"
        },
        {
          "t": "n",
          "text": "皮肉裂开的微痛让我彻底清醒。"
        },
        {
          "t": "n",
          "text": "我左手拉开包，抽出黑皮记录簿。"
        },
        {
          "t": "n",
          "text": "纸页被汗水雨水泡得发胀微卷。"
        },
        {
          "t": "n",
          "text": "铅笔墨水交叠着深紫的油污。"
        },
        {
          "t": "n",
          "text": "啪的一声，我把本子拍在长椅上。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "李阿姨，我兜里一分专项扶持款都没有。平壤铁道厅的章我没盖来，上头早把这儿注销了。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "下河村的三十袋柴油，欠条在我包里，明早我去跟茶嫂核对升数，一分不少算清。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "但你们嘴里的死线和烂摊子，我今天下午用两只脚，从零公里一步一步量到了十五公里！"
        },
        {
          "t": "n",
          "text": "我直接翻开被磨破的第一页。"
        },
        {
          "t": "n",
          "text": "指尖划过被雨水洇开的蓝墨水印。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "三点五公里，老鸦峡背阴弯道。山洪把下侧道床淘空了一米二，道砟全被冲进排洪沟。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "茶嫂装满茶筐的三轮车陷在旁边。我撬了六块护坡石垫轮子，系了红布做标记——那段路，禁试车！"
        },
        {
          "t": "n",
          "text": "赵师傅手里的锤子猛然停住。"
        },
        {
          "t": "n",
          "text": "他浑浊发黄的眼珠死死钉在本上。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "五点二公里，外侧曲线轨距接头。两颗穿心螺栓松动脱扣，道夹板缝隙夹着碎石。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "我卡了车棚那把木道尺，轨距一四三八，超限整整两毫米！机车要是按时速三十开过去，轮缘立刻咬死啃轨！"
        },
        {
          "t": "n",
          "text": "张工猛地跨步上前抢过记录簿。"
        },
        {
          "t": "n",
          "text": "沾满老油泥的拇指在纸上摩挲。"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "shocked",
          "text": "一四三八？你真卡了道尺？那把尺挂在车棚梁上四年，尺头的铜卡爪松了半格，你校准了没？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "我拿游标卡尺校过卡爪的零点误差，扣除零点三毫米磨损。一四三八，只多不少！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "七点八公里处的排水平交管，被山体滑坡下来的碎石杂木堵了九成，上游积水已经漫过护坡脚！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "十一点二公里，抽检五十根木枕，有十八根道钉孔严重滑丝朽烂，必须全部打入木塞重钉！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "还有十五公里松桥站！站牌斜挂在一根铁丝上，水槽裂了三道大缝。挂号钟停在四点五十，是停运那天下午四点五十！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "进站扬旗锈死在水平防护位。茶嫂的车翻了半筐茶，三个老头坐在废长椅上抽旱烟。他们都在问：车什么时候能通？"
        },
        {
          "t": "n",
          "text": "李阿姨抱着账本的手指发颤。"
        },
        {
          "t": "n",
          "text": "算盘上的木珠子碰得细碎作响。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "worried",
          "text": "茶嫂……茶嫂今天真把今年头茬的秋茶采下来了？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "两千斤秋茶全压在下河村农户的仓房里！一斤毛茶市价八沙币，可沙能飞行器一斤运费敲诈三沙币！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "剩五沙币根本连买化肥的本钱都不够！可要是我们用耕牛拖挂一节二十吨闷棚车皮，运费一斤只需两角钱！"
        },
        {
          "t": "n",
          "text": "李阿姨飞快拨动算盘珠子。"
        },
        {
          "t": "n",
          "text": "算盘发出清脆密集的碰撞声。"
        },
        {
          "t": "d",
          "s": "李阿姨",
          "e": "shocked",
          "text": "二十吨车皮……两万公斤茶……一斤收两角运费，单程一趟就是整整四千沙币！"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "二十三公里单程，千分之十二坡度，重载牵引油耗撑死四十五升柴油。柴油成本一百八十沙币，单趟纯利三千八！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "e": "serious",
          "text": "十九天后就是霜降！如果十九天内铁轨通不了、耕牛拉不动，全村一年的冬茶就全烂在泥里，茶农全得给沙能公司打白工！"
        },
        {
          "t": "n",
          "text": "赵师傅狠狠吸了一口冰凉夜气。"
        },
        {
          "t": "n",
          "text": "他猛地将手里的铁皮桶顿在地上。"
        },
        {
          "t": "n",
          "text": "半桶生锈道钉撞出金石般的脆响。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "serious",
          "text": "十九天……老鸦峡淘空一米二，单靠山上滚下来的浮石根本压不住重载。得用道砟筛起道、调平、人工捣固！"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "喷油嘴喷孔积碳卡死，针阀座面磨损。原厂配件全国就剩平壤一家小厂还在做老翻新件，加急走快件也得整整七天！"
        },
        {
          "t": "d",
          "s": "张工",
          "e": "serious",
          "text": "今晚用松动剂泡透螺栓，明早必须拆泵。调校供油提前角得用千分表对准上止点前十五度，差一丝一毫发动机就得反喷！"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "e": "serious",
          "text": "五点二公里松动的那两颗穿心螺栓，明天得换新的弹簧垫圈。道夹板内侧全得刮干净铁锈涂黄油，不然温差一变钢轨就死拉断栓！"
        },
        {
          "t": "n",
          "text": "站台上的空气彻底被点燃了。"
        },
