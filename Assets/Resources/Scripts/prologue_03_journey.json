{
  "id": "prologue_03_journey",
  "scenes": [
    {
      "bg": "border_town",
      "bgm": "first_light",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "Day 1 上午"
        },
        {
          "t": "n",
          "text": "临江市上空"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "林彪悍——醒醒！快到了！",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "嗯...到了？",
          "e": "bored"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "前方五公里，临江市——中朝边境的边贸小城！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "建议补充沙子！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "终于到中国了啊。"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "supply_station",
      "bgm": "calm",
      "d": [
        {
          "t": "n",
          "text": "车辆缓缓降落，停在补给站。"
        },
        {
          "t": "n",
          "text": "补给站是一个普通的小镇设施，有几个加油机一样的设备。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "加多少？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "加满。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "试验车...1500公斤。150沙币。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "150块？1500公斤？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "对啊。沙子便宜。你们朝鲜来的？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "嗯...去雾峰村。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "雾峰村？听着生，没怎么听说过。你们怎么跑那种山旮旯里？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "谢谢。"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "china_sky",
      "bgm": "cloud_rail",
      "transition": "slideLeft",
      "d": [
        {
          "t": "n",
          "text": "补给完成，车辆继续起飞。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "沙子补充满一千五百公斤！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当前续航一千公里！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "下次补给预计在后天下午～"
        },
        {
          "t": "n",
          "text": "继续飞行，林彪悍翻着平板。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "飞了这么久...看看新闻吧。",
          "e": "curious"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "cabin_interior",
      "bgm": "starlit_rails",
      "d": [
        {
          "t": "n",
          "text": "车辆继续向北飞行。窗外是连绵的群山，山脚下隐约能看到一条蜿蜒的公路。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "前方要进边境检查区咯。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "边境检查？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "嗯。根据社会安全省的航空管制规定，飞越边境的载具都要接受出入境检查……"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "等等……我这辆车是学校的，我身上带的那些东西……"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "您是说……那百分之六十七属于非法进口的东西吗？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……你别提醒我。"
        },
        {
          "t": "n",
          "text": "车载警报忽然亮起琥珀色，仪表盘上浮起一行字：「检测到边境管制雷达，扫描频率上升」。"
        },
        {
          "t": "n",
          "text": "三秒后，一道刺耳的电子音撕裂了客舱的安静：「警告：本机已被相位锁定。拦截窗口：四十秒。」"
        },
        {
          "t": "n",
          "text": "林彪悍一下子挺直了背。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "四十秒？！我们不是刚飞过来吗？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "他们在一千米的雷达相位上预先锁定了所有入境载具。这不是例行检查的节奏——他们知道我们要来！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "知道我们要来？怎么可能……"
        },
        {
          "t": "n",
          "text": "前方云层中，两辆深绿色的武装载具破云而出——流线型的沙能军车，车顶架着电磁干扰设备，呈钳形编队悬停在空中。"
        },
        {
          "t": "n",
          "text": "其中一辆侧面的舱门打开，一名穿深绿色制服的人举起红色信号牌：「立即降落接受检查」。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "社会安全省交通运输安全监察局，加上边防军总参谋部的雷达正在对准我们……"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "建议您配合检查哦。"
        },
        {
          "t": "n",
          "text": "林彪悍低声，喉头滚动。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "岁月——如果我让你加速冲过去——"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "不建议。他们最高一百一十，我们只有八十——追不上，但逃也难……"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "我没问你的建议！加速！"
        },
        {
          "t": "n",
          "text": "话音未落，岁月猛地推满动力。0721号像被踹了一脚，引擎发出一声低沉的轰鸣，瞬间向前窜出。"
        },
        {
          "t": "n",
          "text": "林彪悍被惯性狠狠地按在座椅上，炸鸡盒从矮桌上滑落，辛拉面箱在储物格里哐当作响。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当前速度八十！对方开始追了！"
        },
        {
          "t": "n",
          "text": "后视镜里，两辆武装载具迅速调整姿态，拉近距离——车身上的徽记不同：一辆是社会安全省交通运输安全监察局的蓝徽，另一辆是边防军总参谋部的红星。它们的速度更快。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "对方速度一百一十！预计两分钟接触！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……能甩掉吗？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "正在计算逃脱路线——前方两公里有峡谷！可以在里面低空机动！成功率：可以赌一把！"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "赌一把？你的系统什么时候学会赌了？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "您的指令优先级高于风险评估——这是您教我的第一课。系好安全带！"
        },
        {
          "t": "n",
          "text": "0721号猛地压低头部，直插向峡谷。两侧岩壁呼啸而过，林彪悍能感觉到机身在气流里震颤，像一枚贴地飞行的子弹。"
        },
        {
          "t": "n",
          "text": "后方，两辆武装载具紧跟而下，车顶的电磁干扰设备嗡嗡作响——一道蓝色的扫描波扫过车身。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "他们开启电磁干扰了！通讯会被压制——您要是想求救，现在还有十秒哦。"
        },
        {
          "t": "n",
          "text": "林彪悍飞快抄起平板，拨出导师的号码。"
        },
        {
          "t": "n",
          "text": "话筒里只有刺啦的电流声。信号断了。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "靠！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "峡谷出口三百米！前方开阔地——没有遮挡！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "算好了。逃脱概率：百分之三。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……百分之三？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "百分之三的意思是——现在备降还有谈判机会。再拖下去，就是边境管制条例的最重条款了……"
        },
        {
          "t": "n",
          "text": "前方云层中又闪出两辆武装载具——这次车身没有徽记，通体灰黑，是国家安全保卫机关的特勤车。左侧、右侧、前方——三面合围。"
        },
        {
          "t": "cg",
          "text": "cg_chase"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "四家单位！信号干扰全开！导弹制导系统开始预热锁定——他们有开火权限……"
        },
        {
          "t": "n",
          "text": "林彪悍盯着前方灰黑色的特勤车，后槽牙咬紧。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……开火权限。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "嗯。继续逃逸的话，对方有权击落。在它们眼里，您现在是「非法飞行的不明载具」……"
        },
        {
          "t": "n",
          "text": "[逃。还是降。]"
        },
        {
          "t": "n",
          "text": "[爷爷守了一辈子的线还等着我。我不能死在这儿，也不能就这么进去。]"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……降落吧。"
        },
        {
          "t": "n",
          "text": "岁月减速，缓缓降落在下方的公路上。四辆武装载具紧随其后，呈包围阵型落地，激起一圈尘土。"
        },
        {
          "t": "n",
          "text": "车门被人从外面一把拉开。刺眼的阳光照进来，林彪悍眯起眼，看到四五支黑洞洞的枪口指着自己。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "下车。双手抱头。"
        },
        {
          "t": "cg",
          "text": "cg_arrest"
        },
        {
          "t": "n",
          "text": "林彪悍被从车里拽了出来，按在引擎盖上。钢制的引擎盖被太阳晒得发烫，贴上皮肤的一瞬间，他忍不住倒吸一口冷气。有人在他身上快速拍了一遍，翻出了他那张金日成综合大学的学生证。"
        },
        {
          "t": "n",
          "text": "检查员看了看学生证，又看了看车里。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "金日成综合大学的学生？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……是。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第一，违反《出入境管理法》第32条——未经许可驶入边境管制区，擅自穿越国境检查站，构成非法越境。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第二，违反《社会安全法》第41条——驾驶载具拒绝接受检查，强行闯关逃逸，袭扰执法。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第三，违反《贸易法》第23条——携带未经申报的境外商品入境，涉嫌走私。第四，违反《国家保卫法》——车内查获大批韩国文化制品，涉嫌传播反国家宣传物。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第五，在逃逸过程中冲闯三道边防警戒线，情节性质极其恶劣。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "这五项罪名，按朝鲜刑法，光第三条走私就是七年起步，第四项反国家宣传物——进矫正局待三年都是轻的。你算算，合起来是多少年？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……"
        },
        {
          "t": "n",
          "text": "检查员勒了勒他的衣领，凑到他耳边，压低声音：「而且——小子，你刚冲了四家单位的三道警戒线。这事已经报国务院了。你以为你是谁？」"
        },
        {
          "t": "n",
          "text": "检查员松开他，退后半步，从口袋里摸出烟点上。烟雾顺着他的话头慢悠悠飘出来——他眯着眼，像打量一件能谈价钱的货。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "看你这年纪，第一次出远门吧？"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "按规矩，这五项罪名够你在大同江那边的矫正局关十年。十年啊，孩子——等你出来，连你爷爷的名字都记不全了。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "不过，也不是没有别的路。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "你要是老实告诉我，这批货是谁帮你运的、平壤那边还有谁在跑这条线——我可以帮你把罪名归成「初犯过失」。三年，最多。出来还是个完人。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "货是我自己带的。没有别人。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "硬气。像你这样硬气的大学生，我一年见三个，个个都这么说。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "最后还不是招了。你还有念想——好好想想，再回答我一次。"
        },
        {
          "t": "n",
          "text": "林彪悍把脸贴在发烫的引擎盖上没动。汗水顺着鬓角往下淌，淌过他咬紧的下颌。他数着自己的心跳，数到第十二下，才从那声「十年」里缓过来。"
        },
        {
          "t": "n",
          "text": "[要是招了，就是把我爷爷的线也一起招出去了。]"
        },
        {
          "t": "n",
          "text": "[不招，还有机会打电话。]"
        },
        {
          "t": "n",
          "text": "[国务院。]"
        },
        {
          "t": "n",
          "text": "[一个金日成大学的研究生，一天之内把名字送到了国务院。]"
        },
        {
          "t": "n",
          "text": "[爷爷，对不起。我没能守住你的名声。]"
        },
        {
          "t": "n",
          "text": "引擎盖烫得他半边脸发麻，他动了动被反剪的胳膊，把脸从铁皮上抬起来一点——声音闷闷的，带着铁屑味。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……行。那我能打个电话吗？"
        },
        {
          "t": "n",
          "text": "检查员冷笑。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "打给谁？你们校长？还是能救你的什么人？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "打给我的导师。还有……嘉颖徐，女士。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "嘉颖徐？东北亚那个铁路大亨？"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "小伙子，你认识她，她未必认识你。现在风头正紧，谁肯为一个边境上被扣的大学生出头？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……她认识我爷爷。"
        },
        {
          "t": "n",
          "text": "检查员的目光动了一下，第一次没有立刻接话。过了几秒，他伸手把手机递过来——手势比刚才轻了一点。"
        },
        {
          "t": "n",
          "text": "信号干扰还没有完全取消，电话响了好几遍，才终于接通。"
        },
        {
          "t": "n",
          "text": "电话那头的声音传了出来。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "彪悍？怎么了？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "教授……我在边境检查站。他们扣了我，五项罪名，说已经报国务院了。"
        },
        {
          "t": "n",
          "text": "导师沉默了几秒。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "把电话给检查员。"
        },
        {
          "t": "n",
          "text": "林彪悍把平板递过去。检查员皱着眉接起来，放到耳边。"
        },
        {
          "t": "n",
