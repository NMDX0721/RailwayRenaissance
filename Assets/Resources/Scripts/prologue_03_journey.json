{
  "id": "prologue_03_journey",
  "scenes": [
    {
      "bg": "border_town",
      "bgm": "first_light",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "Day 1 上午"
        },
        {
          "t": "n",
          "text": "临江市上空"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "林彪悍...醒醒。快到了。",
          "e": "gentle"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "嗯...到了？",
          "e": "bored"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "前方5公里。临江市，中朝边境的边贸小城。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "建议补充沙子。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "终于到中国了啊。"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "supply_station",
      "bgm": "calm",
      "d": [
        {
          "t": "n",
          "text": "车辆缓缓降落，停在补给站。"
        },
        {
          "t": "n",
          "text": "补给站是一个普通的小镇设施，有几个加油机一样的设备。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "加多少？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "加满。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "试验车...1500公斤。150沙币。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "150块？1500公斤？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "对啊。沙子便宜。你们朝鲜来的？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "嗯...去雾峰村。"
        },
        {
          "t": "d",
          "s": "员工",
          "text": "雾峰村？听着生，没怎么听说过。你们怎么跑那种山旮旯里？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "谢谢。"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "china_sky",
      "bgm": "cloud_rail",
      "transition": "slideLeft",
      "d": [
        {
          "t": "n",
          "text": "补给完成，车辆继续起飞。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "已补充沙子1500公斤。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当前续航：1000公里。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "预计下次补给：Day 2 下午。"
        },
        {
          "t": "n",
          "text": "继续飞行，林彪悍刷手机。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "飞了这么久...看看新闻吧。",
          "e": "curious"
        }
      ],
      "chars": [
        {
          "name": "lin_biaohan",
          "pos": "left"
        }
      ]
    },
    {
      "bg": "cabin_interior",
      "bgm": "starlit_rails",
      "d": [
        {
          "t": "n",
          "text": "车辆继续向北飞行。窗外是连绵的群山，山脚下隐约能看到一条蜿蜒的公路。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "前方即将进入边境检查区域。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "边境检查？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "是的。根据朝鲜社会安全省的航空管制规定，所有飞越边境的沙能载具须接受出入境检查。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "等等……我这辆车是学校的，我身上带的那些东西……"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "您是指那些……百分之六十七属于非法进口的物品？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……你别提醒我。"
        },
        {
          "t": "n",
          "text": "车载警报忽然亮起琥珀色，仪表盘上浮起一行字：「检测到边境管制雷达，扫描频率上升」。"
        },
        {
          "t": "n",
          "text": "三秒后，一道刺耳的电子音撕裂了客舱的安静：「警告：本机已被相位锁定。拦截窗口：四十秒。」"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "（猛地坐直）四十秒？！我们不是刚飞过来吗？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "他们在一千米的雷达相位上预先锁定了所有入境载具。这不是例行检查的节奏——他们知道我们要来。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "知道我们要来？怎么可能……"
        },
        {
          "t": "n",
          "text": "前方云层中，两辆深绿色的武装载具破云而出——流线型的沙能军车，车顶架着电磁干扰设备，呈钳形编队悬停在空中。"
        },
        {
          "t": "n",
          "text": "其中一辆侧面的舱门打开，一名穿深绿色制服的人举起红色信号牌：「立即降落接受检查」。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "社会安全省交通运输安全监察局。同时检测到边防军总参谋部的一部雷达正在对准我们。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "建议您配合检查。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "（低声，喉头滚动）岁月——如果我让你加速冲过去——"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "不建议。他们的速度上限是一百一十公里每小时，我们只有八十。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "我没问你的建议！加速！"
        },
        {
          "t": "n",
          "text": "话音未落，岁月猛地推满动力。0721号像被踹了一脚，引擎发出一声低沉的轰鸣，瞬间向前窜出。"
        },
        {
          "t": "n",
          "text": "林彪悍被惯性狠狠地按在座椅上，炸鸡盒从矮桌上滑落，辛拉面箱在储物格里哐当作响。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当前速度：八十公里每小时。对方开始追击。"
        },
        {
          "t": "n",
          "text": "后视镜里，两辆武装载具迅速调整姿态，拉近距离——车身上的徽记不同：一辆是社会安全省交通运输安全监察局的蓝徽，另一辆是边防军总参谋部的红星。它们的速度更快。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "对方速度：一百一十公里每小时。预计接触时间：两分钟。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……能甩掉吗？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "正在计算逃脱路线——前方两公里处有峡谷，可在峡谷内做低空机动。成功率：可以赌一把。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "赌一把？你的系统什么时候学会赌了？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "您的指令优先级高于风险评估。这是我学到的第一课。系好安全带。"
        },
        {
          "t": "n",
          "text": "0721号猛地压低头部，直插向峡谷。两侧岩壁呼啸而过，林彪悍能感觉到机身在气流里震颤，像一枚贴地飞行的子弹。"
        },
        {
          "t": "n",
          "text": "后方，两辆武装载具紧跟而下，车顶的电磁干扰设备嗡嗡作响——一道蓝色的扫描波扫过车身。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "他们开启电磁干扰。通讯将受到压制——您如果想求救，现在还有十秒。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "（飞快掏出手机，拨出导师的号码）"
        },
        {
          "t": "n",
          "text": "话筒里只有刺啦的电流声。信号断了。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "靠！"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "峡谷出口三百米。前方开阔地——没有遮挡。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "计算完成。逃脱概率：百分之三。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……百分之三？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "百分之三的意思是——如果您现在备降，还有机会谈判。再拖下去，等待您的将是边境管制条例的最重条款。"
        },
        {
          "t": "n",
          "text": "前方云层中又闪出两辆武装载具——这次车身没有徽记，通体灰黑，是国家安全保卫机关的特勤车。左侧、右侧、前方——三面合围。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "四家单位。信号干扰全面开启。导弹制导系统开始预热锁定——他们有开火权限。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "（盯着前方灰黑色的特勤车，后槽牙咬紧）……开火权限。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "是的。如果继续逃逸，对方有权击落目标。您在它们眼里，现在是一架「非法飞行的不明载具」。"
        },
        {
          "t": "n",
          "text": "[逃。还是降。]"
        },
        {
          "t": "n",
          "text": "[爷爷守了一辈子的线还等着我。我不能死在这儿，也不能就这么进去。]"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……降落吧。"
        },
        {
          "t": "n",
          "text": "岁月减速，缓缓降落在下方的公路上。四辆武装载具紧随其后，呈包围阵型落地，激起一圈尘土。"
        },
        {
          "t": "n",
          "text": "车门被人从外面一把拉开。刺眼的阳光照进来，林彪悍眯起眼，看到四五支黑洞洞的枪口指着自己。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "下车。双手抱头。"
        },
        {
          "t": "n",
          "text": "林彪悍被从车里拽了出来，按在引擎盖上。钢制的引擎盖被太阳晒得发烫，贴上皮肤的一瞬间，他忍不住倒吸一口冷气。有人在他身上快速拍了一遍，翻出了他那张金日成综合大学的学生证。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（看了看学生证，又看了看车里）金日成综合大学的学生？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……是。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第一，违反《出入境管理法》第32条——未经许可驶入边境管制区，擅自穿越国境检查站，构成非法越境。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第二，违反《社会安全法》第41条——驾驶载具拒绝接受检查，强行闯关逃逸，袭扰执法。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第三，违反《贸易法》第23条——携带未经申报的境外商品入境，涉嫌走私。第四，违反《国家保卫法》——车内查获大批韩国文化制品，涉嫌传播反国家宣传物。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "第五，在逃逸过程中冲闯三道边防警戒线，情节性质极其恶劣。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "这五项罪名，按朝鲜刑法，光第三条走私就是七年起步，第四项反国家宣传物——三年劳改营都是轻的。你算算，合起来是多少年？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……"
        },
        {
          "t": "n",
          "text": "检查员勒了勒他的衣领，凑到他耳边，压低声音：「而且——小子，你刚冲了四家单位的三道警戒线。这事已经报国务院了。你以为你是谁？」"
        },
        {
          "t": "n",
          "text": "[国务院。]"
        },
        {
          "t": "n",
          "text": "[一个金日成大学的研究生，一天之内把名字送到了国务院。]"
        },
        {
          "t": "n",
          "text": "[爷爷，对不起。我没能守住你的名声。]"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……行。那我能打个电话吗？"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（冷笑）打给谁？你们校长？还是能救你的什么人？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "打给我的导师。还有……一个朋友。"
        },
        {
          "t": "n",
          "text": "检查员看了他几秒，把手机递给他。林彪悍的手指有些发抖，拨通了导师的号码。"
        },
        {
          "t": "n",
          "text": "信号干扰还没有完全取消，电话响了好几遍，才终于接通。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "（电话里）彪悍？怎么了？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "教授……我在边境检查站。他们扣了我，五项罪名，说已经报国务院了。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "（沉默了几秒）把电话给检查员。"
        },
        {
          "t": "n",
          "text": "林彪悍把手机递过去。检查员皱着眉接起来，放到耳边。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "（电话里，声音平静但有力）我是金日成综合大学智能系统研究所所长。这是我的学生，他在执行学校委派的跨区域调研任务。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "他车上携带的物品，属于科研样本采集范畴，已向学校报备。"
        },
        {
          "t": "n",
          "text": "检查员的表情微妙地动了一下。他看了看林彪悍，又看了看车里的炸鸡和动漫钥匙扣——显然，这些东西怎么看都不像科研样本。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（对着电话，语气生硬）同志，您说的这些……我们核实需要时间。但在核实完成之前，按流程他得先移送——"
        },
        {
          "t": "n",
          "text": "检查员的手机突然响了。他低头一看，脸色变了。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（压低声音，对身旁的人）是……局长内线。"
        },
        {
          "t": "n",
          "text": "他接起电话。听了几句，表情从冷漠变成惊讶，从惊讶变成尴尬——最后，他把目光落在林彪悍身上，像在看什么不可思议的东西。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "……你认识嘉颖徐？"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "（愣了一下）……认识。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（挂断电话，沉默了几秒）她刚打电话到我们局长办公室，说你是她资助的铁路研究员。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "说你带的东西……是她批准的。那箱泡面和玩偶，是她的「科研基金」采购清单。"
        },
        {
          "t": "n",
          "text": "[嘉颖徐？她怎么知道我在边境？]"
        },
        {
          "t": "n",
          "text": "[等等——她一个电话，能打到局长内线？]"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "……对。是她批准的。"
        },
        {
          "t": "n",
          "text": "检查员的表情在震惊和无奈之间转了一圈，最后叹了口气，挥手示意其他人收起枪。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（把证件还给他，声音放低，带着一丝若有所思）走吧。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "下次——让你那位「朋友」提前打个招呼。别让我们难做。"
        },
        {
          "t": "n",
          "text": "林彪悍从引擎盖上撑起身子，正要转身，检查员忽然又叫住他。"
        },
        {
          "t": "d",
          "s": "检查员",
          "text": "（看着他，像是在确认什么）……小子。你姓林？"
        },
        {
          "t": "d",
          "s": "林彪悍",
