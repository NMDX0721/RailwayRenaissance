{
  "id": "post_003_qingxi_freight",
  "scenes": [
    {
      "bg": "station_office",
      "bgm": "calm",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "运营第 60 天，车站办公室"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "彪悍，有件事……我一直想跟你说。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "青溪镇。你知道吗？往东四十五公里，翻过茶山就是。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "青溪镇？爷爷提过。说那边有工厂，以前茶叶都往那边运。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "对。青溪镇以前有十二条铁路支线连着周围。后来全废了。现在……那边的人只能靠沙能货车运货。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "上个月青溪镇商会的人找到我。说想问问……我们这条线能不能往东修，接上他们。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "青溪镇——常住人口约一万两千，主打制造业和轻工业。铁路网曾经很发达，现在只剩沙能航线。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "如果能接通的话……光是货运收入，就能让我们的财务翻一倍！"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "不过修线的钱……青溪镇那边说他们可以出一部分。但勘探、铺轨、买机车……都是大钱。"
        },
        {
          "t": "c",
          "text": "要不要推进青溪镇支线？",
          "opts": [
            {
              "text": "答应老陈，开始勘探青溪镇方向（启动区域1解锁链）",
              "next": 1,
              "setValue": "qingxi_accept=true"
            },
            {
              "text": "先稳住雾峰村线，等资金充裕再说",
              "next": 2,
              "setValue": "qingxi_defer=true"
            }
          ]
        }
      ]
    },
    {
      "bg": "railway_track",
      "bgm": "determination",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "林彪悍带着赵师傅和岁月，沿着旧铁路线往东走。"
        },
        {
          "t": "n",
          "text": "废弃的铁轨在杂草中若隐若现，枕木已经腐烂大半。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "text": "这条路……我年轻时走过。以前一天跑两趟，茶农矿工都坐这车。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "text": "铁轨主体还在，但枕木要全换。信号系统……你看看，全废了。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "初步评估：铁轨主体完好率约60%，枕木需更换80%，信号系统需重建。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "估算修复成本：约8万沙币。加上新购一台货运机车……总计需要约15万沙币。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "十五万……我们现在账上有多少？"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "当前余额：约五万两千沙币。缺口接近十万。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "text": "小林，这条线修好了，青溪镇的货就能走铁路。比沙能货车便宜三成，还快。"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "text": "青溪镇商会那边……我去谈谈，看他们能出多少。"
        }
      ]
    },
    {
      "bg": "station_office",
      "bgm": "calm",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "三天后，赵师傅带回消息"
        },
        {
          "t": "d",
          "s": "赵师傅",
          "text": "谈下来了。青溪镇商会愿意出三万沙币，条件是——货运专列优先运他们的货。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "三万……加上我们现在的五万二，还差七万。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "如果接受青溪镇的条件，预计三个月内货运收入可以覆盖剩余缺口。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "但有一个风险：如果沙能公司在青溪镇也搞渗透，我们的货运份额可能被抢。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "彪悍，你怎么想？"
        },
        {
          "t": "c",
          "text": "如何推进？",
          "opts": [
            {
              "text": "接受青溪镇条件，用未来货运收入抵押贷款（风险高，但快）",
              "next": 3,
              "setValue": "qingxi_method=loan"
            },
            {
              "text": "分阶段修，先修一半通到茶山站（稳妥，但慢）",
              "next": 4,
              "setValue": "qingxi_method=phased"
            }
          ]
        }
      ]
    },
    {
      "bg": "station_office",
      "bgm": "determination",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "林彪悍联系了镇上的信用合作社，用雾峰村线的运营收入做担保，贷了七万沙币。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "三个月。三个月内货运收入必须覆盖贷款。否则……"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "不会有否则的。青溪镇的工厂等着运货，茶叶也等着往外走。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "已记录：青溪镇支线修复计划启动。预计两个月完工。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "新功能解锁：货运专列。可以承接青溪镇方向的货运订单了！"
        },
        {
          "t": "n",
          "text": "【区域1·青溪镇支线解锁中——完成后开放货运专列】"
        }
      ]
    },
    {
      "bg": "railway_track",
      "bgm": "first_light",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "两个月后。青溪镇方向的铁轨修复完成。"
        },
        {
          "t": "n",
          "text": "新的枕木铺好了，信号系统重新上线，茶山站重新挂牌。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "茶山站……好久没听到这个名字了。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "陈爷爷，货运专列准备好了吗？"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "好了。青溪镇第一批货——三千斤茶叶，五百箱零件。等着发车呢。"
        },
        {
          "t": "d",
          "s": "岁月",
          "text": "货运专列首次发车！目的地：青溪镇。预计运行时间：1小时20分。"
        },
        {
          "t": "d",
          "s": "林彪悍",
          "text": "发车。"
        },
        {
          "t": "n",
          "text": "汽笛响起。货运列车缓缓驶出雾峰村站，向东驶去。"
        },
        {
          "t": "n",
          "text": "【青溪镇支线解锁完成。货运收入已接入经济系统。】"
        },
        {
          "t": "n",
          "text": "【区域1·青溪镇——已解锁】"
        }
      ]
    }
  ]
}
