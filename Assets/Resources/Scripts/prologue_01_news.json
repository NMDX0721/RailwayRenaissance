{
  "id": "prologue_01_news",
  "scenes": [
    {
      "bg": "black",
      "bgm": "",
      "transition": "fade",
      "d": [
        {
          "t": "loc",
          "text": "2076年4月 · 雾峰站"
        },
        {
          "t": "n",
          "text": "清晨。机车棚里，柴油机咳了三声，熄火。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "再来一次……求你了，再来一次。"
        },
        {
          "t": "n",
          "text": "启动机嘶吼了两秒，轰鸣没起来，又坠回寂静。喷油泵的位置传来一声闷响——像什么东西彻底断了弦。"
        },
        {
          "t": "d",
          "s": "老陈",
          "text": "……不行了。"
        },
        {
          "t": "n",
          "text": "老陈松开闸把，在机车旁站了很久。站台上没有一个乘客。"
        },
        {
          "t": "loc",
          "text": "雾峰村线 · 正式停运"
        },
        {
          "t": "n",
          "text": "风穿过空荡荡的候车室，把墙上那张时刻表吹得哗哗作响。"
        }
      ]
    },
    {
      "bg": "news_2050",
      "bgm": "",
      "transition": "fade",
      "d": [
        {
          "t": "loc",
          "text": "2050年 · 伦敦"
        },
        {
          "t": "n",
          "text": "世界首辆沙能试验车「奇幻沙子」面世——沙子，成了新的石油。"
        },
        {
          "t": "n",
          "text": "各国车厂抢身入场。没有人注意到，铁路的时代开始倒计时。"
        }
      ]
    },
    {
      "bg": "news_2072",
      "bgm": "melancholy",
      "transition": "fade",
      "d": [
        {
          "t": "loc",
          "text": "2072年 · 大废线"
        },
        {
          "t": "n",
          "text": "全球铁路基本停运。官方叫它「全面战略转型」，铁路工人叫它——大废线。"
        },
        {
          "t": "n",
          "text": "最后还活着的，只剩深山里那些被世界忘掉的小线。"
        },
        {
          "t": "n",
          "text": "比如雾峰村这一段，二十三公里，蜷在江南的雾气里。"
        }
      ]
    },
    {
      "bg": "lab",
      "bgm": "melancholy",
      "transition": "fade",
      "chars": [
        { "name": "lin_biaohan", "pos": "left" },
        { "name": "daoshi", "pos": "right" }
      ],
      "d": [
        {
          "t": "loc",
          "text": "2076年5月 · 平壤 金日成综合大学 实验室"
        },
        {
          "t": "n",
          "text": "但四年过去了..."
        },
        {
          "t": "n",
          "text": "男大学生伏在调度算法终端前。屏幕幽光闪烁，那条未完成的最优路径仍在徒劳演算。"
        },
        {
          "t": "n",
          "text": "导师推门进来，手里捏着一张便签，没有寒暄。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "你过来看看这个。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，怎么了？",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "你爷爷以前工作的那条线……雾峰村那边，有人找。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "……",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "是老陈打来的。他说机车坏了，线路快撑不住了。"
        },
        {
          "t": "n",
          "text": "便签上字迹潦草，像是电话里匆匆记下的：喷油嘴、停运、四年。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "……四年。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "何止四年。你爷爷当年就是在这条线上，一干就是四十年。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我想回去看看。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "我猜到了。所以……我已经帮你安排好了。"
        }
      ]
    },
    {
      "bg": "professor_office",
      "bgm": "melancholy",
      "transition": "fade",
      "chars": [
        { "name": "lin_biaohan", "pos": "left" },
        { "name": "daoshi", "pos": "right" }
      ],
      "d": [
        {
          "t": "n",
          "text": "当天中午，导师办公室。他桌上摊着休学申请表。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "沙子飞猪号0721号，停在下面的停机坪。你随时可以出发。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我……想申请学业暂停。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "我已经签好字了。紧急情况特殊处理。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "您……早就知道我会回去？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "老陈每周都会打电话来问你的情况。他说……你是那条线最后的希望。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我爷爷……他守了一辈子铁路。现在那条线快撑不住了。我不能在这里做着理论研究，却看着它消亡。",
          "e": "worried"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "但你要想清楚……一旦离开，再回来就不容易了。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "我想清楚了。谢谢您，教授。",
          "e": "serious"
        },
        {
          "t": "n",
          "text": "他收起申请表，看向窗外停机坪方向——深蓝色的0721号在阳光下反着光。"
        }
      ]
    }
  ],
  "nextScript": "prologue_02_day0"
}
