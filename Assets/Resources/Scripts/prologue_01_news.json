{
  "id": "prologue_01_news",
  "scenes": [
    {
      "bg": "news_2050",
      "bgm": "",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "2050年5月，世界首辆沙能试验车『奇幻沙子』在英国伦敦正式面世。"
        },
        {
          "t": "n",
          "text": "它通过革命性技术将沙子转化为高效能源，无需燃油或电力。只需添加沙子，车辆便可长时间稳定行驶。"
        },
        {
          "t": "n",
          "text": "这一技术突破被全球数十个国家的能源专家视为应对全球能源危机的重要解决方案。"
        },
        {
          "t": "n",
          "text": "美国、德国、日本等国的汽车制造商纷纷宣布投资沙能技术，抢占先机。"
        },
        {
          "t": "n",
          "text": "社会各界普遍期待这一技术尽快成熟，带领全球迈向更可持续的未来。"
        }
      ]
    },
    {
      "bg": "hangar",
      "bgm": "",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "2053年7月，沙能可飞行汽车『沙子飞猪号』正式开始商用，由联合沙能科学技术会社研发。"
        },
        {
          "t": "n",
          "text": "它以沙子为能源，极为廉价，兼具环保和高效两大优势。可瞬间切换为飞行模式，像鸟儿一样飞向空中。"
        },
        {
          "t": "n",
          "text": "与此同时，世界第一辆沙能坦克『金正恩大沙子型』在朝鲜正式下线，标志着沙能技术进入军事领域。"
        },
        {
          "t": "n",
          "text": "沙能技术的广泛应用将带来能源消费和军事格局的根本性变化。"
        }
      ]
    },
    {
      "bg": "news_2072",
      "bgm": "melancholy",
      "transition": "fade",
      "d": [
        {
          "t": "n",
          "text": "从那时起，沙能科技迅速崛起。"
        },
        {
          "t": "n",
          "text": "各国纷纷投资沙能载具，铁路逐渐被边缘化。"
        },
        {
          "t": "n",
          "text": "到2072年，全球铁路几乎全面停运。"
        },
        {
          "t": "n",
          "text": "沙能技术看似完美，但高歌猛进之下，暗流涌动。"
        }
      ]
    },
    {
      "bg": "lab",
      "bgm": "melancholy",
      "transition": "fade",
      "chars": [
        { "name": "lin_biaohan", "pos": "left" },
        { "name": "daoshi", "pos": "right" }
      ],
      "d": [
        {
          "t": "loc",
          "text": "2076年5月 · 平壤 金日成综合大学 实验室"
        },
        {
          "t": "n",
          "text": "但四年过去了..."
        },
        {
          "t": "n",
          "text": "男大学生伏在调度算法终端前。屏幕幽光闪烁，那条未完成的最优路径仍在徒劳演算。"
        },
        {
          "t": "n",
          "text": "导师推门进来，手里捏着一张便签，没有寒暄。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "你过来看看这个。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，怎么了？",
          "e": "curious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "你爷爷以前工作的那条线……雾峰村那边，有人找。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "……",
          "e": "sad"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "是老陈打来的。他说机车坏了，线路快撑不住了。"
        },
        {
          "t": "n",
          "text": "便签上字迹潦草，像是电话里匆匆记下的：喷油嘴、停运、四年。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "……四年。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "何止四年。你爷爷当年就是在这条线上，一干就是四十年。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我想回去看看。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "我猜到了。所以……我已经帮你安排好了。"
        }
      ]
    },
    {
      "bg": "professor_office",
      "bgm": "melancholy",
      "transition": "fade",
      "chars": [
        { "name": "lin_biaohan", "pos": "left" },
        { "name": "daoshi", "pos": "right" }
      ],
      "d": [
        {
          "t": "n",
          "text": "当天中午，导师办公室。他桌上摊着休学申请表。"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "沙子飞猪号0721号，停在下面的停机坪。你随时可以出发。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我……想申请学业暂停。",
          "e": "serious"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "我已经签好字了。紧急情况特殊处理。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "您……早就知道我会回去？",
          "e": "surprise"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "老陈每周都会打电话来问你的情况。他说……你是那条线最后的希望。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "教授，我爷爷……他守了一辈子铁路。现在那条线快撑不住了。我不能在这里做着理论研究，却看着它消亡。",
          "e": "worried"
        },
        {
          "t": "d",
          "s": "导师",
          "text": "但你要想清楚……一旦离开，再回来就不容易了。"
        },
        {
          "t": "d",
          "s": "男大学生",
          "text": "我想清楚了。谢谢您，教授。",
          "e": "serious"
        },
        {
          "t": "n",
          "text": "他收起申请表，看向窗外停机坪方向——深蓝色的0721号在阳光下反着光。"
        }
      ]
    }
  ],
  "nextScript": "prologue_02_day0"
}
